# .env.example - Environment Configuration Template
# Copy this file to .env and fill in your values

# Application
APP_NAME=WeppenTest Platform
APP_VERSION=1.0.0
DEBUG=False

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1

# Database
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./weppentest.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/weppentest

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-to-a-random-secret-key-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Scan Settings
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT_SECONDS=3600
MAX_SCAN_DEPTH=3
RESULTS_RETENTION_DAYS=90

# Domain Verification
DOMAIN_VERIFICATION_REQUIRED=True
VERIFICATION_TOKEN_PREFIX=weppentest-verify

# Tool Paths (auto-detect or specify manually)
# Leave empty for auto-detection
NMAP_PATH=nmap
SQLMAP_PATH=sqlmap
NIKTO_PATH=nikto
HYDRA_PATH=hydra
WPSCAN_PATH=wpscan
WHATWEB_PATH=whatweb
DIRSEARCH_PATH=dirsearch
SUBFINDER_PATH=subfinder
HTTPX_PATH=httpx

# Reporting
REPORT_OUTPUT_DIR=./reports
# REPORT_LOGO_PATH=./assets/logo.png

# Legal & Compliance
ACCEPT_LEGAL_TERMS_REQUIRED=True
AUDIT_LOG_ENABLED=True
GDPR_COMPLIANT=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/weppentest.log

# Email (for notifications - future)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@weppentest.com

# Webhook (for integrations - future)
# WEBHOOK_URL=https://your-webhook.com/endpoint
# WEBHOOK_SECRET=your-webhook-secret
